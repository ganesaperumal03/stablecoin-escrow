# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file! (.gitignore already excludes it.)

# The private key that pays gas and deploys (a TEST wallet only!)
PRIVATE_KEY=0xyour_test_wallet_private_key

# Optional: for `--verify` to work on Basescan
BASESCAN_API_KEY=your_basescan_api_key

# Optional deal settings (the script has defaults)
PAYEE=0x0000000000000000000000000000000000000000
ARBITER=0x0000000000000000000000000000000000000000
AMOUNT=100000000
WINDOW=604800
